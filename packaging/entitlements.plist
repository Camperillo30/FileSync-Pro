<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Permisos (entitlements) con los que se firma FileSync Pro.app al usar Developer ID.
  La notarización exige el "runtime reforzado", y con él Python necesita estas excepciones:
  - allow-unsigned-executable-memory: ctypes y algunas extensiones crean memoria ejecutable.
  - disable-library-validation: el intérprete carga bibliotecas que PyInstaller extrae del paquete.
  No se pide acceso a cámara, micrófono, red de entrada ni nada más.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
