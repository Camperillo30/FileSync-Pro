FILESYNC_PRO_LICENSE_REDEEM_URL=https://hook.us2.make.com/TU_WEBHOOK_DE_CANJE
FILESYNC_PRO_LICENSE_SIGNING_SECRET=PEGA_AQUI_EL_SECRETO_DE_FIRMA_DE_MAKE
FILESYNC_PRO_DEFAULT_PLAN_CODE=basica
WOMPI_SUBSCRIPTION_LINK_MAP={"basica":"LINK_PLAN_BASICA","pro":"LINK_PLAN_PRO","premium":"LINK_PLAN_PREMIUM"}

# Modo desarrollador: SOLO al ejecutar desde el código fuente (nunca dentro del .exe).
FILESYNC_PRO_DEV_MODE=0
# FILESYNC_PRO_DEV_HOSTNAMES=NOMBRE_DE_TU_PC

# ── Firma de código en Windows (opcional: build.ps1 firma solo si hay certificado) ──
# Huella SHA-1 de tu certificado de firma de código (la ves con: Get-ChildItem Cert:\CurrentUser\My -CodeSigningCert).
# FILESYNC_SIGN_CERT_THUMBPRINT=
# O bien un archivo .pfx con su contraseña:
# FILESYNC_SIGN_PFX=C:\ruta\certificado.pfx
# FILESYNC_SIGN_PFX_PASSWORD=
# Servidor de sello de tiempo (por defecto el de Certum).
# FILESYNC_SIGN_TIMESTAMP_URL=http://time.certum.pl
# Ruta de signtool.exe si no se encuentra solo.
# FILESYNC_SIGNTOOL=

# Ruta de ISCC.exe de Inno Setup, solo si build.ps1 no lo encuentra solo.
# FILESYNC_ISCC=C:\Program Files\Inno Setup 7\ISCC.exe
