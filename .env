# === FileSync Pro — Configuración local ===
# Este archivo NO se distribuye con el .exe

# URL del Google Sheet publicado como CSV (sistema de licencias)
FILESYNC_PRO_SHEETS_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vQvh9IJdUCdyxIfAd3_Dx0PDr1Hm2_a0U5v2KoBG-MBNUO1U3wbZ6dld4rguHxExJlvCOce_uyQVb1X/pub?gid=0&single=true&output=csv

# Plan por defecto al abrir la pantalla de compra
FILESYNC_PRO_DEFAULT_PLAN_CODE=basica

# Links de pago de Wompi (producción)
WOMPI_SUBSCRIPTION_LINK_MAP={"basica":"https://checkout.wompi.co/l/i8Erwh","pro":"https://checkout.wompi.co/l/SYVQ0M","premium":"https://checkout.wompi.co/l/HQB1kI"}

# Equipo propietario (acceso completo sin licencia)
FILESYNC_PRO_OWNER_HOSTNAMES=DESKTOP-335GNPS
FILESYNC_PRO_OWNER_DEVICE_IDS=

# Modo desarrollador (nunca distribuir con valor 1)
FILESYNC_PRO_DEV_MODE=0
FILESYNC_PRO_DEV_DEVICE_IDS=
